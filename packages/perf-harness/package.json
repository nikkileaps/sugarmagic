{
  "name": "@sugarmagic/perf-harness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Standalone GPU perf rig: drives the real RenderView loop over a tunable plain-three load in a headed real-Chrome Playwright session. QA tooling only -- never shipped in the app.",
  "scripts": {
    "dev": "vite",
    "measure:load": "node driver/measure-load.mjs",
    "measure:live": "node driver/measure-live.mjs",
    "attribute:render": "node driver/attribute-render.mjs",
    "capture": "node driver/auto-capture.mjs",
    "probe:mask": "node driver/mask-probe.mjs",
    "probe:sky": "node driver/sky-probe.mjs",
    "probe:postprocess": "node driver/postprocess-probe.mjs",
    "probe:fog": "node driver/fog-probe.mjs",
    "probe:mountain": "node driver/mountain-probe.mjs",
    "probe:light-budget": "node driver/light-budget.mjs"
  },
  "dependencies": {
    "@sugarmagic/render-web": "workspace:*",
    "three": "^0.183.2",
    "@sugarmagic/domain": "workspace:*"
  },
  "devDependencies": {
    "playwright-core": "^1.61.1",
    "vite": "^8.0.3"
  }
}
