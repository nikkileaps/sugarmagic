{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sugarmagic.dev/sugarlang/schemas/competency-inventory.schema.json",
  "title": "Sugarlang Competency Inventory",
  "description": "GENERATED from data/curriculum/<band>.json and data/languages/<lang>/exponents.json. Never hand-edited. What a learner can do at each CEFR band, and the phrases that perform it in one language.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lang", "lessons", "competencies"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2"
    },
    "lang": {
      "type": "string",
      "minLength": 2
    },
    "lessons": {
      "description": "Topics within a band. A lesson is what a situation can match -- a cafe is food, a ticket window is transport.",
      "type": "array",
      "items": { "$ref": "#/$defs/lesson" }
    },
    "competencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/competency" }
    }
  },
  "$defs": {
    "cefrBand": {
      "type": "string",
      "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lessonId", "band", "ordinal", "displayName"],
      "properties": {
        "lessonId": { "type": "string", "minLength": 1 },
        "band": { "$ref": "#/$defs/cefrBand" },
        "ordinal": {
          "description": "Position within the band. `A1.5` is band plus ordinal, derived and never stored.",
          "type": "integer",
          "minimum": 1
        },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "exponent": {
      "description": "A phrase that performs a competency. Not the same as a chunk: a chunk is any multi-word expression, an exponent performs THIS competency.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exponentId",
        "normalizedForm",
        "surfaceForms",
        "cefrBand",
        "constituentLemmas"
      ],
      "properties": {
        "exponentId": { "type": "string", "minLength": 1 },
        "normalizedForm": { "type": "string", "minLength": 1 },
        "surfaceForms": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "cefrBand": { "$ref": "#/$defs/cefrBand" },
        "constituentLemmas": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "competency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competencyId",
        "lessonId",
        "displayName",
        "cefrDescriptor",
        "band",
        "exponents"
      ],
      "properties": {
        "competencyId": { "type": "string", "minLength": 1 },
        "lessonId": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "cefrDescriptor": { "type": "string", "minLength": 1 },
        "band": { "$ref": "#/$defs/cefrBand" },
        "placementGateBand": { "$ref": "#/$defs/cefrBand" },
        "isItemZero": { "type": "boolean" },
        "interpretLexiconCategory": {
          "type": "string",
          "enum": ["farewell", "greeting", "gratitude", "acknowledgement"]
        },
        "exponents": {
          "type": "object",
          "description": "Performing phrases per language (BCP-47 key).",
          "propertyNames": { "type": "string", "minLength": 2 },
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/exponent" }
          }
        }
      }
    }
  }
}
