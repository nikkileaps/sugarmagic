{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sugarmagic.dev/sugarlang/schemas/cefrlex.schema.json",
  "title": "Sugarlang CEFR Lexicon",
  "description": "Plugin-shipped lexical atlas data keyed by lemma id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lang",
    "atlasVersion",
    "lemmas"
  ],
  "properties": {
    "lang": {
      "type": "string",
      "minLength": 2
    },
    "atlasVersion": {
      "type": "string",
      "minLength": 1
    },
    "lemmas": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/atlasLemmaEntry"
      }
    }
  },
  "$defs": {
    "cefrBand": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "atlasLemmaEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lemmaId",
        "lang",
        "cefrPriorBand",
        "frequencyRank",
        "partsOfSpeech",
        "cefrPriorSource"
      ],
      "properties": {
        "lemmaId": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "minLength": 2
        },
        "cefrPriorBand": {
          "$ref": "#/$defs/cefrBand"
        },
        "frequencyRank": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "partsOfSpeech": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "glosses": {
          "type": "object",
          "description": "Translations keyed by support-language code (e.g. { \"en\": \"job, work\" }).",
          "propertyNames": {
            "type": "string",
            "minLength": 2
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cefrPriorSource": {
          "type": "string",
          "enum": [
            "cefrlex",
            "frequency-derived",
            "claude-classified",
            "human-override",
            "kelly"
          ]
        },
        "forms": {
          "description": "Inflected forms, shaped by part of speech. Read through runtime/classifier/word-forms.ts, never by bare index.",
          "oneOf": [
            {
              "type": "object",
              "description": "Verb paradigm. Six slots per tense in person order (1s,2s,3s,1p,2p,3p); null where the form does not exist.",
              "additionalProperties": false,
              "required": [
                "pres",
                "pret",
                "imp",
                "ger",
                "part"
              ],
              "properties": {
                "pres": {
                  "type": "array",
                  "minItems": 6,
                  "maxItems": 6,
                  "description": "Six slots in person order: 1s, 2s, 3s, 1p, 2p, 3p. Null where the form does not exist for this verb (llover has no first person).",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "pret": {
                  "type": "array",
                  "minItems": 6,
                  "maxItems": 6,
                  "description": "Six slots in person order: 1s, 2s, 3s, 1p, 2p, 3p. Null where the form does not exist for this verb (llover has no first person).",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "imp": {
                  "type": "array",
                  "minItems": 6,
                  "maxItems": 6,
                  "description": "Six slots in person order: 1s, 2s, 3s, 1p, 2p, 3p. Null where the form does not exist for this verb (llover has no first person).",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "ger": {
                  "type": "string",
                  "minLength": 1
                },
                "part": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Noun. Number only -- a feminine noun is a separate lemma.",
              "required": [
                "sg",
                "pl"
              ],
              "properties": {
                "sg": {
                  "type": "string",
                  "minLength": 1
                },
                "pl": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Adjective. Gender and number; fs/fp null for the invariable ones (verde, feliz).",
              "required": [
                "ms",
                "fs",
                "mp",
                "fp"
              ],
              "properties": {
                "ms": {
                  "type": "string",
                  "minLength": 1
                },
                "fs": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "mp": {
                  "type": "string",
                  "minLength": 1
                },
                "fp": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "formsSource": {
          "type": "string",
          "description": "Provenance of `forms`. Only `generated` may be overwritten by a seeding script.",
          "enum": [
            "generated",
            "reviewed",
            "authored"
          ]
        }
      }
    }
  }
}
